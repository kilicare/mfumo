generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                 String              @id @default(cuid())
  name               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  address            String?
  allowNegativeStock Boolean             @default(false)
  businessType       String
  costingMethod      String              @default("WEIGHTED_AVERAGE")
  currency           String              @default("TZS")
  description        String?
  email              String?
  financialYear      String              @default("CALENDAR")
  isSetupComplete    Boolean             @default(false)
  isActive           Boolean             @default(true)
  logoUrl            String?
  phone              String?
  taxPercentage      Float               @default(18.0)
  website            String?
  periods            AccountingPeriod[]
  auditLogs          AuditLog[]
  categories         Category[]
  costingMethods     CostingMethod?
  customers          Customer[]
  customerTypes      CustomerType[]
  expenses           Expense[]
  expenseCategories  ExpenseCategory[]
  financials         FinancialSummary[]
  grns               GoodsReceivedNote[]
  movements          InventoryMovement[]
  locations          Location[]
  payments           Payment[]
  paymentMethods     PaymentMethod[]
  permissions        Permission[]
  products           Product[]
  purchases          PurchaseOrder[]
  purchaseReturns    PurchaseReturn[]
  roles              Role[]
  sales              SalesInvoice[]
  salesReturns       SalesReturn[]
  adjustments        StockAdjustment[]
  audits             StockAudit[]
  transfers          StockTransfer[]
  suppliers          Supplier[]
  users              User[]

  @@index([name])
  @@index([createdAt])
}

model User {
  id                     String        @id @default(cuid())
  businessId             String
  email                  String        @unique
  passwordHash           String
  firstName              String
  lastName               String
  phone                  String?
  avatar                 String?
  isActive               Boolean       @default(true)
  isVerified             Boolean       @default(false)
  verificationToken      String?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  lastLogin              DateTime?
  createdAuditLogs       AuditLog[]    @relation("AuditCreatedBy")
  assignedLocations      Location[]    @relation("LocationManager")
  business               Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions               UserSession[]
  permissions            Permission[]  @relation("UserPermissions")
  userRoles              UserRole[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
}

model Role {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  description String?
  isDefault   Boolean      @default(false)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions Permission[] @relation("RolePermissions")
  userRoles   UserRole[]

  @@unique([businessId, name])
  @@index([businessId])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(cuid())
  businessId  String
  key         String
  name        String
  description String?
  category    String
  action      String
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles       Role[]   @relation("RolePermissions")
  users       User[]   @relation("UserPermissions")

  @@unique([businessId, key])
  @@index([businessId])
  @@index([category])
}

model Category {
  id               String     @id @default(cuid())
  businessId       String
  name             String
  description      String?
  parentCategoryId String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentCategory   Category?  @relation("SubCategories", fields: [parentCategoryId], references: [id])
  subCategories    Category[] @relation("SubCategories")
  products         Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Unit {
  id               String        @id @default(cuid())
  name             String        @unique
  symbol           String        @unique
  description      String?
  baseUnit         String?
  conversionFactor Float         @default(1.0)
  isDefault        Boolean       @default(false)
  isSystem         Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  productUnits     ProductUnit[]
  products         Product[]

  @@index([name])
}

model ProductUnit {
  id               String   @id @default(cuid())
  productId        String
  unitId           String
  conversionFactor Float
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit             Unit     @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  products    Product[]

  @@index([name])
}

model Product {
  id              String                @id @default(cuid())
  businessId      String
  sku             String
  name            String
  barcode         String?               @unique
  description     String?
  categoryId      String
  supplierId      String?
  brandId         String?
  buyingPrice     Float
  sellingPrice    Float
  wholesalePrice  Float?
  margin          Float?
  minimumStock    Int                   @default(10)
  reorderLevel    Int                   @default(15)
  defaultUnitId   String?
  status          String                @default("ACTIVE")
  manufacturer    String?
  weight          Float?
  color           String?
  size            String?
  expiryDays      Int?
  requiresExpiry  Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  grnItems        GRNItem[]
  movements       InventoryMovement[]
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        Category              @relation(fields: [categoryId], references: [id])
  supplier        Supplier?             @relation(fields: [supplierId], references: [id])
  brand           Brand?                @relation(fields: [brandId], references: [id])
  defaultUnit     Unit?                 @relation(fields: [defaultUnitId], references: [id])
  units           ProductUnit[]
  purchaseItems   PurchaseOrderItem[]
  purchaseReturns PurchaseReturnItem[]
  invoiceItems    SalesInvoiceItem[]
  returns         SalesReturnItem[]
  adjustmentItems StockAdjustmentItem[]
  auditItems      StockAuditItem[]
  stocks          StockBalance[]
  transferItems   StockTransferItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([brandId])
  @@index([status])
  @@index([defaultUnitId])
}

model CustomerType {
  id          String     @id @default(cuid())
  businessId  String
  name        String
  description String?
  isSystem    Boolean    @default(false)
  customers   Customer[]
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}

model Customer {
  id             String         @id @default(cuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  address        String?
  customerTypeId String
  creditLimit    Float          @default(0)
  openingBalance Float          @default(0)
  paymentTerms   String?
  taxNumber      String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerType   CustomerType   @relation(fields: [customerTypeId], references: [id])
  payments       Payment[]
  invoices       SalesInvoice[]

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId])
  @@index([customerTypeId])
}

model Supplier {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  address        String?
  contactPerson  String?
  contactPhone   String?
  taxNumber      String?
  paymentTerms   String?
  openingBalance Float           @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payments       Payment[]
  products       Product[]
  purchases      PurchaseOrder[]
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId])
}

model Location {
  id            String              @id @default(cuid())
  businessId    String
  name          String
  code          String
  address       String?
  phone         String?
  managerId     String?
  type          String              @default("WAREHOUSE")
  description   String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     InventoryMovement[]
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager       User?               @relation("LocationManager", fields: [managerId], references: [id])
  invoices      SalesInvoice[]
  audits        StockAuditItem[]
  stocks        StockBalance[]
  transfersFrom StockTransfer[]     @relation("TransferFrom")
  transfersTo   StockTransfer[]     @relation("TransferTo")

  @@unique([businessId, code])
  @@index([businessId])
  @@index([managerId])
}

model PaymentMethod {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expenses    Expense[]
  payments    Payment[]
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expenses    Expense[]
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  businessId       String
  supplierId       String
  orderNumber      String
  orderDate        DateTime
  expectedDelivery DateTime?
  status           String              @default("DRAFT")
  subtotal         Float               @default(0)
  taxAmount        Float               @default(0)
  totalAmount      Float               @default(0)
  totalPaid        Float               @default(0)
  notes            String?
  attachments      String?
  createdBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  grn              GoodsReceivedNote?
  payments         Payment[]           @relation("PurchasePayments")
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  returns          PurchaseReturn[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  productId   String
  orderedQty  Int
  receivedQty Int           @default(0)
  acceptedQty Int           @default(0)
  rejectedQty Int           @default(0)
  unitPrice   Float
  total       Float
  notes       String?
  lineNo      Int
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
}

model GoodsReceivedNote {
  id           String        @id @default(cuid())
  businessId   String
  poId         String        @unique
  grnNumber    String        @unique
  grnDate      DateTime
  status       String        @default("DRAFT")
  notes        String?
  receivedDate DateTime
  receivedBy   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        GRNItem[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@unique([businessId, grnNumber])
  @@index([businessId])
  @@index([poId])
  @@index([status])
}

model GRNItem {
  id           String            @id @default(cuid())
  grnId        String
  productId    String
  orderedQty   Int
  receivedQty  Int
  acceptedQty  Int
  rejectedQty  Int               @default(0)
  damageQty    Int               @default(0)
  unitPrice    Float
  qualityNotes String?
  grn          GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id])

  @@index([grnId])
  @@index([productId])
}

model PurchaseReturn {
  id           String               @id @default(cuid())
  businessId   String
  poId         String
  returnNumber String               @unique
  returnDate   DateTime
  reason       String
  totalAmount  Float
  status       String               @default("DRAFT")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  po           PurchaseOrder        @relation(fields: [poId], references: [id])
  items        PurchaseReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([poId])
}

model PurchaseReturnItem {
  id        String         @id @default(cuid())
  returnId  String
  productId String
  quantity  Int
  unitPrice Float
  total     Float
  reason    String?
  product   Product        @relation(fields: [productId], references: [id])
  return    PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
}

model SalesInvoice {
  id              String             @id @default(cuid())
  businessId      String
  customerId      String
  locationId      String
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  status          String             @default("DRAFT")
  subtotal        Float              @default(0)
  discountAmount  Float              @default(0)
  discountPercent Float              @default(0)
  taxAmount       Float              @default(0)
  totalAmount     Float              @default(0)
  totalPaid       Float              @default(0)
  balance         Float
  salespersonId   String?
  notes           String?
  attachments     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  payments        Payment[]          @relation("SalesPayments")
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id])
  location        Location           @relation(fields: [locationId], references: [id])
  items           SalesInvoiceItem[]
  returns         SalesReturn[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([locationId])
  @@index([status])
  @@index([invoiceDate])
}

model SalesInvoiceItem {
  id        String       @id @default(cuid())
  invoiceId String
  productId String
  quantity  Int
  unitPrice Float
  discount  Float        @default(0)
  total     Float
  lineNo    Int
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model SalesReturn {
  id           String            @id @default(cuid())
  businessId   String
  invoiceId    String
  returnNumber String            @unique
  returnDate   DateTime
  reason       String
  totalAmount  Float
  status       String            @default("DRAFT")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice      SalesInvoice      @relation(fields: [invoiceId], references: [id])
  items        SalesReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([invoiceId])
}

model SalesReturnItem {
  id        String      @id @default(cuid())
  returnId  String
  productId String
  quantity  Int
  unitPrice Float
  total     Float
  reason    String?
  condition String?
  product   Product     @relation(fields: [productId], references: [id])
  return    SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
}

model StockBalance {
  id               String    @id @default(cuid())
  productId        String
  locationId       String
  quantity         Float     @default(0)
  lastMovementAt   DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  location         Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model InventoryMovement {
  id          String   @id @default(cuid())
  businessId  String
  productId   String
  locationId  String
  type        String
  quantity    Float
  referenceId String?
  referenceType String?
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@index([businessId])
  @@index([productId])
  @@index([locationId])
  @@index([type])
}

model StockTransfer {
  id             String              @id @default(cuid())
  businessId     String
  fromLocationId String
  toLocationId   String
  transferNumber String              @unique
  transferDate   DateTime
  status         String              @default("DRAFT")
  createdBy      String?
  approvedBy     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromLocation   Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation     Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  items          StockTransferItem[]

  @@unique([businessId, transferNumber])
  @@index([businessId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  productId  String
  quantity   Int
  unit       String
  product    Product       @relation(fields: [productId], references: [id])
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

model StockAdjustment {
  id               String                @id @default(cuid())
  businessId       String
  adjustmentNumber String                @unique
  adjustmentDate   DateTime
  reason           String
  status           String                @default("DRAFT")
  createdBy        String?
  approvedBy       String?
  rejectionReason  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items            StockAdjustmentItem[]

  @@unique([businessId, adjustmentNumber])
  @@index([businessId])
  @@index([status])
}

model StockAdjustmentItem {
  id           String          @id @default(cuid())
  adjustmentId String
  productId    String
  currentQty   Int
  adjustedQty  Int
  difference   Int
  reason       String?
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
}

model StockAudit {
  id          String           @id @default(cuid())
  businessId  String
  auditNumber String           @unique
  auditDate   DateTime
  status      String           @default("DRAFT")
  createdBy   String?
  completedBy String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       StockAuditItem[]

  @@unique([businessId, auditNumber])
  @@index([businessId])
  @@index([status])
}

model StockAuditItem {
  id          String     @id @default(cuid())
  auditId     String
  productId   String
  locationId  String
  systemQty   Int
  physicalQty Int
  variance    Int
  notes       String?
  audit       StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  location    Location   @relation(fields: [locationId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])

  @@index([auditId])
  @@index([productId])
  @@index([locationId])
}

model Payment {
  id              String         @id @default(cuid())
  businessId      String
  paymentNumber   String         @unique
  paymentDate     DateTime
  customerId      String?
  supplierId      String?
  invoiceId       String?
  poId            String?
  amount          Float
  paymentMethodId String
  reference       String?
  notes           String?
  attachments     String?
  status          String         @default("RECORDED")
  createdBy       String?
  verifiedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?      @relation(fields: [customerId], references: [id])
  invoice         SalesInvoice?  @relation("SalesPayments", fields: [invoiceId], references: [id])
  paymentMethod   PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  po              PurchaseOrder? @relation("PurchasePayments", fields: [poId], references: [id])
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])

  @@unique([businessId, paymentNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([supplierId])
  @@index([invoiceId])
  @@index([poId])
}

model Expense {
  id              String          @id @default(cuid())
  businessId      String
  expenseNumber   String          @unique
  expenseDate     DateTime
  categoryId      String
  amount          Float
  description     String
  paymentMethodId String?
  paidBy          String?
  attachmentUrl   String?
  status          String          @default("DRAFT")
  approvedBy      String?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  paymentMethod   PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])

  @@unique([businessId, expenseNumber])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
}

model FinancialSummary {
  id             String   @id @default(cuid())
  businessId     String
  period         String
  startDate      DateTime
  endDate        DateTime
  totalRevenue   Float    @default(0)
  totalCOGS      Float    @default(0)
  grossProfit    Float    @default(0)
  totalExpenses  Float    @default(0)
  netProfit      Float    @default(0)
  totalSales     Int      @default(0)
  totalPurchases Int      @default(0)
  stockValue     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, period])
  @@index([businessId])
  @@index([startDate])
}

model CostingMethod {
  id         String   @id @default(cuid())
  businessId String   @unique
  method     String   @default("WEIGHTED_AVERAGE")
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  businessId   String
  period       String
  startDate    DateTime
  endDate      DateTime
  status       String    @default("OPEN")
  closedBy     String?
  closedAt     DateTime?
  closingNotes String?
  createdAt    DateTime  @default(now())
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, period])
  @@index([businessId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  action      String
  entityType  String
  entityId    String
  beforeData  String?
  afterData   String?
  ipAddress   String?
  userAgent   String?
  description String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User     @relation("AuditCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
