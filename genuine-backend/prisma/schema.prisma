generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  address               String?
  allowNegativeStock    Boolean                @default(false)
  businessType          String
  costingMethod         String                 @default("WEIGHTED_AVERAGE")
  currency              String                 @default("TZS")
  description           String?
  email                 String?
  financialYear         String                 @default("CALENDAR")
  isSetupComplete       Boolean                @default(false)
  isActive              Boolean                @default(true)
  logoUrl               String?
  phone                 String?
  taxPercentage         Float                  @default(18.0)
  website               String?
  periods               AccountingPeriod[]
  auditLogs             AuditLog[]
  categories            Category[]
  costingMethods        CostingMethod?
  customers             Customer[]
  customerTypes         CustomerType[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  financials            FinancialSummary[]
  grns                  GoodsReceivedNote[]
  movements             InventoryMovement[]
  locations             Location[]
  payments              Payment[]
  paymentMethods        PaymentMethod[]
  permissions           Permission[]
  products              Product[]
  purchases             PurchaseOrder[]
  purchaseReturns       PurchaseReturn[]
  roles                 Role[]
  sales                 SalesInvoice[]
  salesReturns          SalesReturn[]
  adjustments           StockAdjustment[]
  audits                StockAudit[]
  transfers             StockTransfer[]
  physicalCounts        PhysicalCount[]
  suppliers             Supplier[]
  users                 User[]
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  emailConfig           EmailConfig?
  smsConfig             SMSConfig?

  @@index([name])
  @@index([createdAt])
}

model User {
  id                     String                  @id @default(cuid())
  businessId             String
  email                  String                  @unique
  passwordHash           String
  firstName              String
  lastName               String
  phone                  String?
  avatar                 String?
  isActive               Boolean                 @default(true)
  isVerified             Boolean                 @default(false)
  verificationToken      String?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lastLogin              DateTime?
  createdAuditLogs       AuditLog[]              @relation("AuditCreatedBy")
  assignedLocations      Location[]              @relation("LocationManager")
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions               UserSession[]
  permissions            Permission[]            @relation("UserPermissions")
  userRoles              UserRole[]
  createdExpenses        Expense[]               @relation("ExpenseCreatedBy")
  approvedExpenses       Expense[]               @relation("ExpenseApprovedBy")
  paidExpenses           Expense[]               @relation("ExpensePaidBy")
  rejectedExpenses       Expense[]               @relation("ExpenseRejectedBy")
  inAppNotifications     InAppNotification[]
  notificationRecipients NotificationRecipient[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
}

model Role {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  description String?
  isDefault   Boolean      @default(false)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions Permission[] @relation("RolePermissions")
  userRoles   UserRole[]

  @@unique([businessId, name])
  @@index([businessId])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(cuid())
  businessId  String
  key         String
  name        String
  description String?
  category    String
  action      String
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles       Role[]   @relation("RolePermissions")
  users       User[]   @relation("UserPermissions")

  @@unique([businessId, key])
  @@index([businessId])
  @@index([category])
}

model Category {
  id               String     @id @default(cuid())
  businessId       String
  name             String
  description      String?
  parentCategoryId String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentCategory   Category?  @relation("SubCategories", fields: [parentCategoryId], references: [id])
  subCategories    Category[] @relation("SubCategories")
  products         Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Unit {
  id               String        @id @default(cuid())
  name             String        @unique
  symbol           String        @unique
  description      String?
  baseUnit         String?
  conversionFactor Float         @default(1.0)
  isDefault        Boolean       @default(false)
  isSystem         Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  productUnits     ProductUnit[]
  products         Product[]

  @@index([name])
}

model ProductUnit {
  id               String   @id @default(cuid())
  productId        String
  unitId           String
  conversionFactor Float
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit             Unit     @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  logo        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@index([name])
}

model Product {
  id                 String                @id @default(cuid())
  businessId         String
  sku                String
  name               String
  barcode            String?               @unique
  description        String?
  categoryId         String
  supplierId         String?
  brandId            String?
  buyingPrice        Float
  sellingPrice       Float
  wholesalePrice     Float?
  margin             Float?
  minimumStock       Int                   @default(10)
  reorderLevel       Int                   @default(15)
  defaultUnitId      String?
  status             String                @default("ACTIVE")
  manufacturer       String?
  weight             Float?
  color              String?
  size               String?
  expiryDays         Int?
  requiresExpiry     Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  movements          InventoryMovement[]
  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category           Category              @relation(fields: [categoryId], references: [id])
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  brand              Brand?                @relation(fields: [brandId], references: [id])
  defaultUnit        Unit?                 @relation(fields: [defaultUnitId], references: [id])
  units              ProductUnit[]
  purchaseItems      PurchaseOrderItem[]
  invoiceItems       SalesInvoiceItem[]
  returns            SalesReturnItem[]
  adjustmentItems    StockAdjustmentItem[]
  auditItems         StockAuditItem[]
  stocks             StockBalance[]
  transferItems      StockTransferItem[]
  physicalCountItems PhysicalCountItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([brandId])
  @@index([status])
  @@index([defaultUnitId])
}

model CustomerType {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}

model Customer {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  customerCode   String
  customerType   String // RETAIL, WHOLESALE, CORPORATE, DISTRIBUTOR
  description    String?
  email          String
  phone          String
  secondaryPhone String?
  taxId          String?
  creditLimit    Float             @default(0)
  paymentTerms   String // NET-7, NET-14, NET-30, NET-45, NET-60, COD, PREPAID
  openingBalance Float             @default(0)
  isActive       Boolean           @default(true)
  contacts       CustomerContact[]
  address        CustomerAddress?
  salesInvoices  SalesInvoice[]
  salesReturns   SalesReturn[]
  payments       Payment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([businessId, customerCode])
  @@index([businessId])
  @@index([customerType])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  phone      String
  position   String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street     String
  city       String
  region     String
  postalCode String
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Supplier {
  id                String            @id @default(uuid())
  businessId        String
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  supplierCode      String
  description       String?
  email             String
  phone             String
  secondaryPhone    String?
  bankName          String?
  bankAccountNumber String?
  bankSwiftCode     String?
  taxId             String?
  creditLimit       Float             @default(0)
  paymentTerms      String // NET-7, NET-14, NET-30, NET-45, NET-60, CASH
  openingBalance    Float             @default(0)
  isActive          Boolean           @default(true)
  contacts          SupplierContact[]
  address           SupplierAddress?
  purchaseOrders    PurchaseOrder[]
  purchaseReturns   PurchaseReturn[]
  payments          Payment[]
  expenses          Expense[]
  products          Product[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([businessId, supplierCode])
  @@index([businessId])
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  phone      String
  position   String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

model SupplierAddress {
  id         String   @id @default(uuid())
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  street     String
  city       String
  region     String
  postalCode String
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Location {
  id              String                @id @default(cuid())
  businessId      String
  name            String
  code            String
  address         String?
  phone           String?
  managerId       String?
  type            String                @default("WAREHOUSE")
  description     String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  movements       InventoryMovement[]
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  manager         User?                 @relation("LocationManager", fields: [managerId], references: [id])
  invoices        SalesInvoice[]
  audits          StockAuditItem[]
  stocks          StockBalance[]
  transfersFrom   StockTransfer[]       @relation("TransferFrom")
  transfersTo     StockTransfer[]       @relation("TransferTo")
  adjustmentItems StockAdjustmentItem[]
  physicalCounts  PhysicalCount[]
  purchaseOrders  PurchaseOrder[]
  expenses        Expense[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([managerId])
}

model PaymentMethod {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expenses    Expense[]
  payments    Payment[]
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId])
}

model ExpenseCategory {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  code         String
  description  String?
  budgetLimit  Float?
  budgetPeriod String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  expenses     Expense[]
  expenseItems ExpenseItem[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  businessId           String
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  poNumber             String
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  locationId           String
  location             Location            @relation(fields: [locationId], references: [id])
  status               String              @default("DRAFT") // DRAFT, ORDERED, PARTIALLY_RECEIVED, FULLY_RECEIVED, CLOSED, CANCELLED
  items                PurchaseOrderItem[]
  grns                 GoodsReceivedNote[]
  returns              PurchaseReturn[]
  payments             Payment[]           @relation("PurchasePayments")
  subtotal             Float
  shippingCost         Float               @default(0)
  taxAmount            Float               @default(0)
  totalAmount          Float
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  approvedBy           String?
  approvedAt           DateTime?
  cancelledBy          String?
  cancelledAt          DateTime?
  notes                String?
  referenceNumber      String?
  createdBy            String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([businessId, poNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String               @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product              @relation(fields: [productId], references: [id])
  quantity        Float
  unitPrice       Float
  discount        Float                @default(0)
  lineTotal       Float
  notes           String?
  grnItems        GRNItem[]
  returnItems     PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceivedNote {
  id                  String        @id @default(uuid())
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  grnNumber           String
  purchaseOrderId     String
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  status              String        @default("RECEIVED") // RECEIVED, ACCEPTED, REJECTED
  items               GRNItem[]
  vehicleRegistration String?
  driverName          String?
  waybillNumber       String?
  receivedBy          String
  receivedDate        DateTime
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([businessId, grnNumber])
  @@index([businessId])
  @@index([purchaseOrderId])
}

model GRNItem {
  id                  String            @id @default(uuid())
  grnId               String
  grn                 GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  receivedQuantity    Float
  acceptedQuantity    Float
  rejectedQuantity    Float
  damageQuantity      Float
  notes               String?
  batchNumber         String?
  expiryDate          DateTime?

  @@index([grnId])
  @@index([purchaseOrderItemId])
}

model PurchaseReturn {
  id                String               @id @default(uuid())
  businessId        String
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  returnNumber      String
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  supplierId        String
  supplier          Supplier             @relation(fields: [supplierId], references: [id])
  status            String               @default("DRAFT") // DRAFT, APPROVED, REJECTED, COMPLETED
  items             PurchaseReturnItem[]
  totalReturnAmount Float
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  createdBy         String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([purchaseOrderId])
}

model PurchaseReturnItem {
  id                  String            @id @default(uuid())
  purchaseReturnId    String
  purchaseReturn      PurchaseReturn    @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantity            Float
  reason              String // DEFECTIVE, EXPIRED, WRONG_ITEM, OVERAGE, OTHER
  notes               String?

  @@index([purchaseReturnId])
  @@index([purchaseOrderItemId])
}

model SalesInvoice {
  id              String             @id @default(cuid())
  businessId      String
  customerId      String
  locationId      String
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  status          String             @default("DRAFT")
  subtotal        Float              @default(0)
  discountAmount  Float              @default(0)
  discountPercent Float              @default(0)
  taxAmount       Float              @default(0)
  totalAmount     Float              @default(0)
  totalPaid       Float              @default(0)
  balance         Float
  salespersonId   String?
  createdBy       String?
  referenceNumber String?
  paymentTerms    String             @default("COD")
  issuedDate      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  cancelledBy     String?
  cancelledAt     DateTime?
  notes           String?
  attachments     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  payments        Payment[]          @relation("SalesPayments")
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id])
  location        Location           @relation(fields: [locationId], references: [id])
  items           SalesInvoiceItem[]
  returns         SalesReturn[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([locationId])
  @@index([status])
  @@index([invoiceDate])
}

model SalesInvoiceItem {
  id                 String            @id @default(cuid())
  invoiceId          String
  productId          String
  quantity           Float
  unitPrice          Float
  discount           Float             @default(0)
  discountPercentage Float             @default(0)
  total              Float
  lineNo             Int
  batchNumber        String?
  expiryDate         String?
  notes              String?
  invoice            SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id])
  returnItems        SalesReturnItem[]

  @@index([invoiceId])
  @@index([productId])
}

model SalesReturn {
  id           String            @id @default(cuid())
  businessId   String
  invoiceId    String
  customerId   String?
  returnNumber String            @unique
  returnDate   DateTime
  reason       String
  totalAmount  Float
  status       String            @default("DRAFT")
  notes        String?
  createdBy    String?
  authorizedBy String?
  authorizedAt DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  receivedBy   String?
  receivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice      SalesInvoice      @relation(fields: [invoiceId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  items        SalesReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId])
  @@index([invoiceId])
}

model SalesReturnItem {
  id                 String            @id @default(cuid())
  returnId           String
  productId          String
  salesInvoiceItemId String?
  quantity           Float
  unitPrice          Float
  total              Float
  reason             String?
  condition          String?
  notes              String?
  product            Product           @relation(fields: [productId], references: [id])
  return             SalesReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  salesInvoiceItem   SalesInvoiceItem? @relation(fields: [salesInvoiceItemId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@index([productId])
  @@index([salesInvoiceItemId])
}

model StockBalance {
  id             String   @id @default(cuid())
  productId      String
  locationId     String
  quantity       Float    @default(0)
  lastMovementAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model InventoryMovement {
  id            String    @id @default(cuid())
  businessId    String
  productId     String
  locationId    String
  type          String
  quantity      Float
  referenceId   String?
  referenceType String?
  notes         String?
  unitCost      Float?
  batchNumber   String?
  expiryDate    DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location      Location  @relation(fields: [locationId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])

  @@index([businessId])
  @@index([productId])
  @@index([locationId])
  @@index([type])
}

model StockTransfer {
  id             String              @id @default(cuid())
  businessId     String
  fromLocationId String
  toLocationId   String
  transferNumber String
  status         String              @default("DRAFT")
  transferDate   DateTime            @default(now())
  sentDate       DateTime?
  receivedDate   DateTime?
  reason         String?
  notes          String?
  sentBy         String?
  receivedBy     String?
  createdBy      String?
  approvedBy     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromLocation   Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation     Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  items          StockTransferItem[]

  @@unique([businessId, transferNumber])
  @@index([businessId])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockTransferItem {
  id               String        @id @default(cuid())
  transferId       String
  productId        String
  quantity         Float
  unit             String        @default("UNIT")
  batchNumber      String?
  notes            String?
  receivedQuantity Float         @default(0)
  unitCost         Float?
  product          Product       @relation(fields: [productId], references: [id])
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

model StockAdjustment {
  id               String                @id @default(cuid())
  businessId       String
  adjustmentNumber String
  adjustmentDate   DateTime
  reason           String
  status           String                @default("PENDING")
  createdBy        String?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items            StockAdjustmentItem[]

  @@unique([businessId, adjustmentNumber])
  @@index([businessId])
  @@index([status])
}

model StockAdjustmentItem {
  id           String          @id @default(cuid())
  adjustmentId String
  productId    String
  currentQty   Float
  adjustedQty  Float
  difference   Float
  locationId   String?
  batchNumber  String?
  notes        String?
  reason       String?
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  location     Location?       @relation(fields: [locationId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
}

model StockAudit {
  id          String           @id @default(cuid())
  businessId  String
  auditNumber String           @unique
  auditDate   DateTime
  status      String           @default("DRAFT")
  createdBy   String?
  completedBy String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       StockAuditItem[]

  @@unique([businessId, auditNumber])
  @@index([businessId])
  @@index([status])
}

model StockAuditItem {
  id          String     @id @default(cuid())
  auditId     String
  productId   String
  locationId  String
  systemQty   Float
  physicalQty Float
  variance    Float
  notes       String?
  audit       StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  location    Location   @relation(fields: [locationId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])

  @@index([auditId])
  @@index([productId])
  @@index([locationId])
}

model PhysicalCount {
  id                  String              @id @default(uuid())
  businessId          String
  locationId          String
  countNumber         String
  status              String              @default("DRAFT")
  varianceCount       Int                 @default(0)
  totalVarianceAmount Float               @default(0)
  completedDate       DateTime?
  postedDate          DateTime?
  notes               String?
  createdBy           String
  completedBy         String?
  postedBy            String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location            Location            @relation(fields: [locationId], references: [id])
  items               PhysicalCountItem[]

  @@unique([businessId, countNumber])
  @@index([businessId])
  @@index([locationId])
  @@index([status])
}

model PhysicalCountItem {
  id              String        @id @default(uuid())
  physicalCountId String
  productId       String
  systemQuantity  Float
  countedQuantity Float
  variance        Float
  batchNumber     String?
  notes           String?
  physicalCount   PhysicalCount @relation(fields: [physicalCountId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@unique([physicalCountId, productId, batchNumber])
  @@index([physicalCountId])
  @@index([productId])
}

model Payment {
  id                     String         @id @default(cuid())
  businessId             String
  paymentNumber          String
  paymentDate            DateTime
  customerId             String?
  supplierId             String?
  invoiceId              String?
  poId                   String?
  expenseId              String?
  referenceType          String?
  referenceId            String?
  direction              String?
  amount                 Float
  paymentMethodId        String
  reference              String?
  referenceNumber        String?
  notes                  String?
  attachments            String?
  status                 String         @default("RECORDED")
  createdBy              String?
  verifiedBy             String?
  bankName               String?
  accountNumber          String?
  chequeNumber           String?
  transactionId          String?
  isReconciled           Boolean        @default(false)
  bankStatementReference String?
  reconciledBy           String?
  reconciledAt           DateTime?
  voidedBy               String?
  voidedAt               DateTime?
  voidReason             String?
  idempotencyKey         String?
  processedAt            DateTime       @default(now())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  business               Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer               Customer?      @relation(fields: [customerId], references: [id])
  invoice                SalesInvoice?  @relation("SalesPayments", fields: [invoiceId], references: [id])
  paymentMethod          PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  po                     PurchaseOrder? @relation("PurchasePayments", fields: [poId], references: [id])
  supplier               Supplier?      @relation(fields: [supplierId], references: [id])
  expense                Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([businessId, paymentNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
  @@index([supplierId])
  @@index([invoiceId])
  @@index([poId])
  @@index([expenseId])
  @@index([businessId, status, paymentDate])
}

model Expense {
  id               String          @id @default(cuid())
  businessId       String
  expenseNumber    String
  expenseDate      DateTime
  categoryId       String
  amount           Float
  description      String
  reference        String?
  paymentReference String?
  notes            String?
  paymentMethodId  String?
  paidBy           String?
  paidAt           DateTime?
  isPaid           Boolean         @default(false)
  locationId       String?
  supplierId       String?
  createdBy        String?
  approvedAt       DateTime?
  attachmentUrl    String?
  budgetCode       String?
  approvalNotes    String?
  status           String          @default("DRAFT")
  approvedBy       String?
  rejectionReason  String?
  rejectedBy       String?
  rejectedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  paymentMethod    PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  location         Location?       @relation(fields: [locationId], references: [id])
  supplier         Supplier?       @relation(fields: [supplierId], references: [id])
  createdByUser    User?           @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  approvedByUser   User?           @relation("ExpenseApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  paidByUser       User?           @relation("ExpensePaidBy", fields: [paidBy], references: [id], onDelete: SetNull)
  rejectedByUser   User?           @relation("ExpenseRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  items            ExpenseItem[]
  payments         Payment[]

  @@unique([businessId, expenseNumber])
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([businessId, supplierId])
  @@index([businessId, status, expenseDate])
}

model ExpenseItem {
  id          String          @id @default(cuid())
  expenseId   String
  categoryId  String
  amount      Float
  description String?
  notes       String?
  expense     Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([expenseId])
  @@index([categoryId])
}

model FinancialSummary {
  id             String   @id @default(cuid())
  businessId     String
  period         String
  startDate      DateTime
  endDate        DateTime
  totalRevenue   Float    @default(0)
  totalCOGS      Float    @default(0)
  grossProfit    Float    @default(0)
  totalExpenses  Float    @default(0)
  netProfit      Float    @default(0)
  totalSales     Int      @default(0)
  totalPurchases Int      @default(0)
  stockValue     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, period])
  @@index([businessId])
  @@index([startDate])
}

model CostingMethod {
  id         String   @id @default(cuid())
  businessId String   @unique
  method     String   @default("WEIGHTED_AVERAGE")
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  businessId   String
  period       String
  startDate    DateTime
  endDate      DateTime
  status       String    @default("OPEN")
  closedBy     String?
  closedAt     DateTime?
  closingNotes String?
  lockedBy     String?
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, period])
  @@index([businessId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  action      String
  entityType  String
  entityId    String
  beforeData  String?
  afterData   String?
  ipAddress   String?
  userAgent   String?
  description String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User     @relation("AuditCreatedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

model UserSession {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  type        String
  eventType   String
  subject     String
  body        String   @db.Text
  description String?
  variables   String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@index([businessId, eventType, type, isActive])
}

model Notification {
  id             String                  @id @default(cuid())
  businessId     String
  type           String
  eventType      String
  status         String                  @default("PENDING")
  subject        String
  body           String                  @db.Text
  referenceId    String?
  referenceType  String?
  idempotencyKey String?
  attemptCount   Int                     @default(0)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients     NotificationRecipient[]
  logs           NotificationLog[]
  inboxEntries   InAppNotification[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, status, nextRetryAt])
  @@index([businessId, eventType, createdAt])
  @@index([referenceType, referenceId])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String?
  email          String?
  phoneNumber    String?
  name           String
  status         String       @default("PENDING")
  sentAt         DateTime?
  failureReason  String?
  providerId     String?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([notificationId, userId])
  @@index([notificationId, status])
  @@index([email])
  @@index([phoneNumber])
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  recipient      String
  status         String
  message        String
  responseCode   Int?
  timestamp      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, timestamp])
}

model InAppNotification {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, isRead, createdAt])
}

model EmailConfig {
  businessId String   @id
  provider   String
  fromEmail  String
  fromName   String
  config     String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SMSConfig {
  businessId String   @id
  provider   String
  fromNumber String
  config     String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
