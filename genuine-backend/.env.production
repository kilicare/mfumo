# Provide JWT_SECRET, JWT_REFRESH_SECRET, and JWT_RESET_SECRET as deployment secrets (32+ chars each).
# Do not store production signing secrets in this file or commit them.
DATABASE_URL=${DATABASE_URL}
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"
API_PORT=3002
NODE_ENV="production"
ALLOW_NEGATIVE_STOCK="false"
DEFAULT_COSTING_METHOD="WEIGHTED_AVERAGE"
LOG_LEVEL="info"
CORS_ORIGIN="https://your-domain.com"
SESSION_IDLE_TIMEOUT="7d"
SESSION_ABSOLUTE_TIMEOUT="30d"
